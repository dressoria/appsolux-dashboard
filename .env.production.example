# =============================================================================
# appsolux-dashboard — Production environment template
# Domain: https://app.bionvers.com
#
# Copy to .env.production and fill in real values.
# NEVER commit .env.production — it is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# App identity
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Appsolux
NEXT_PUBLIC_APP_URL=https://app.bionvers.com
APPSOLUX_PUBLIC_APP_URL=https://app.bionvers.com
APP_ENV=production

# -----------------------------------------------------------------------------
# Database
# Inside Docker the host is the container name, not localhost.
# The appsolux-db container must be in the same Docker network.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@appsolux-db:5432/appsolux_core?schema=public

# -----------------------------------------------------------------------------
# Session / auth
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
APPSOLUX_AUTH_SECRET=change_me_64_hex_chars
APP_SESSION_SECRET=change_me_64_hex_chars
INTERNAL_API_SECRET=change_me

# Prod: always false
APPSOLUX_ENABLE_DEV_SESSION=false
APPSOLUX_CORE_DB_REQUIRED=true
APPSOLUX_ALLOW_LEGACY_ERP_ACTIVE=false

# Internal admin emails (comma-separated)
APPSOLUX_INTERNAL_ADMIN_EMAILS=admin@yourdomain.com

# Dev credentials — leave empty in production
APPSOLUX_DEV_EMAIL=
APPSOLUX_DEV_PASSWORD=

# -----------------------------------------------------------------------------
# Redis (optional — leave empty if not used)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Chatwoot
# -----------------------------------------------------------------------------
CHATWOOT_BASE_URL=https://chatwoot.yourdomain.com
CHATWOOT_ADMIN_API_ACCESS_TOKEN=change_me
CHATWOOT_API_ACCESS_TOKEN=change_me
CHATWOOT_BOT_API_ACCESS_TOKEN=change_me
CHATWOOT_PLATFORM_API_TOKEN=change_me
CHATWOOT_OPERATIONAL_USER_ID=1
CHATWOOT_OPERATIONAL_USER_EMAIL=bot@yourdomain.com
APPSOLUX_CHATWOOT_WEBHOOK_TOKEN=change_me

# -----------------------------------------------------------------------------
# ERPNext
# -----------------------------------------------------------------------------
ERPNEXT_BASE_URL=https://erp.yourdomain.com
ERPNEXT_API_KEY=change_me
ERPNEXT_API_SECRET=change_me
ERP_PROVISIONING_DEFAULT_DOMAIN=yourdomain.com

# -----------------------------------------------------------------------------
# Evolution API (WhatsApp)
# -----------------------------------------------------------------------------
EVOLUTION_API_BASE_URL=https://evolution.yourdomain.com
EVOLUTION_API_KEY=change_me
EVOLUTION_WEBHOOK_SECRET=change_me
EVOLUTION_CHATWOOT_LOGO_URL=https://app.bionvers.com/logo.png

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
N8N_BASE_URL=https://n8n.yourdomain.com
N8N_REGISTER_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/register
N8N_PROVISION_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/provision
N8N_WEBHOOK_SECRET=change_me

# -----------------------------------------------------------------------------
# Meta (WhatsApp Cloud API / Instagram / Messenger)
# -----------------------------------------------------------------------------
META_APP_ID=change_me
META_APP_SECRET=change_me
META_VERIFY_TOKEN=change_me
META_GRAPH_API_VERSION=v19.0
META_WHATSAPP_BUSINESS_ACCOUNT_ID=change_me
META_WHATSAPP_ACCESS_TOKEN=change_me
META_PAGE_ACCESS_TOKEN=change_me
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=change_me

# -----------------------------------------------------------------------------
# SRI firma electrónica
# SRI_CERT_STORAGE_PATH must match the Docker volume mount path.
# SRI_CERT_ENCRYPTION_KEY must match the key used to encrypt certs in the UI.
# Generate key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
SRI_CERT_ENCRYPTION_KEY=change_me_64_hex_chars
SRI_CERT_STORAGE_PATH=/app/.appsolux-secure/sri-certificates
SRI_SIGNED_XML_STORAGE_PATH=/app/.appsolux-secure/sri-signed-xml
