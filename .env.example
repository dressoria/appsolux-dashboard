# ─────────────────────────────────────────────
# Plataforma principal
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Panel empresarial
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL publica canonica usada por integraciones y webhooks del servidor.
# En produccion debe coincidir con el dominio real (ej. https://app.bionvers.com).
PLATFORM_PUBLIC_URL=http://localhost:3000
APPSOLUX_PUBLIC_APP_URL=http://localhost:3000

# Correo de soporte mostrado en la plataforma.
SUPPORT_EMAIL=soporte@empresa.com

# ─────────────────────────────────────────────
# Entorno y sesion
# ─────────────────────────────────────────────
APP_ENV=development
APP_SESSION_SECRET=
APPSOLUX_AUTH_SECRET=
APPSOLUX_AUTH_PROVIDER=current
APPSOLUX_ENABLE_DEV_SESSION=true
APPSOLUX_DEV_EMAIL=admin@empresa.com
APPSOLUX_DEV_PASSWORD=
APPSOLUX_DEV_NAME=Admin
APPSOLUX_DEV_TENANT_NAME=Mi Empresa
APPSOLUX_DEV_TENANT_SLUG=mi-empresa

# ─────────────────────────────────────────────
# Supabase Auth (opcional — solo para modo dual)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# Base de datos principal (Appsolux Core DB)
# ─────────────────────────────────────────────
# PostgreSQL recomendado para produccion SaaS.
# Esta base es la fuente de verdad para usuarios, tenants, memberships,
# integraciones y onboarding.
#
# IMPORTANTE:
# - No usar la base de Chatwoot (chatwoot_prod).
# - No usar bases de ERPNext/Frappe.
# - Usar una base independiente: appsolux_core.
# - Nunca commitear usuarios, contrasenas o tokens reales.
#
# Desarrollo local:
# DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:5432/appsolux_core?schema=public"
#
# Produccion / Docker / Coolify (conexion directa):
# DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@appsolux-db:5432/appsolux_core?schema=public"
#
# Produccion con PgBouncer (recomendado para limitar conexiones en produccion):
# DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@pgbouncer:6432/appsolux_core?schema=public&pgbouncer=true&connect_timeout=10"
# Nota: PgBouncer en modo transaction requiere ?pgbouncer=true en la URL de Prisma.
DATABASE_URL=

# Stripe Billing (usar claves y Prices de Stripe Test durante validación)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# En desarrollo puede ser false. En produccion debe ser true.
APPSOLUX_CORE_DB_REQUIRED=false

# ─────────────────────────────────────────────
# Servicios externos — flags de activacion
# ─────────────────────────────────────────────
# Cada servicio tiene su propio flag.
# Si el flag es false, la app no llama al servicio aunque la URL este configurada.
# Si el flag es true y falta la URL, la integracion devolvera error controlado.

# n8n — automatizaciones y aprovisionamiento
N8N_ENABLED=false
N8N_BASE_URL=
N8N_REGISTER_WEBHOOK_URL=
N8N_PROVISION_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Chatwoot — conversaciones y atencion al cliente
CHATWOOT_ENABLED=false
CHATWOOT_BASE_URL=
# Token de plataforma para aprovisionar cuentas, usuarios y roles. Solo server-side.
CHATWOOT_PLATFORM_API_TOKEN=
# Token de perfil SuperAdmin para administracion interna.
CHATWOOT_ADMIN_API_ACCESS_TOKEN=
# Token del Bot de Appsolux para conversaciones y mensajes. Solo server-side.
CHATWOOT_BOT_API_ACCESS_TOKEN=
# Fallback legacy. Preferir CHATWOOT_BOT_API_ACCESS_TOKEN.
CHATWOOT_API_ACCESS_TOKEN=
# Usuario Chatwoot global asignado a nuevas cuentas de tenant. Solo server-side.
CHATWOOT_OPERATIONAL_USER_ID=
CHATWOOT_OPERATIONAL_USER_EMAIL=

# ERPNext — clientes, facturacion, contabilidad
ERP_ENABLED=false
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Dominio base para sitios ERP dedicados. Solo necesario si ERP_ENABLED=true.
ERP_PROVISIONING_DEFAULT_DOMAIN=

# Evolution API — WhatsApp via QR / instancia
EVOLUTION_ENABLED=false
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_CHATWOOT_LOGO_URL=

# ─────────────────────────────────────────────
# Meta API (WhatsApp Cloud, Instagram, Messenger)
# ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=

META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─────────────────────────────────────────────
# Interno
# ─────────────────────────────────────────────
INTERNAL_API_SECRET=
