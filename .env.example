# Appsolux
NEXT_PUBLIC_APP_NAME=Appsolux
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public server URL used by backend integrations and webhooks.
APPSOLUX_PUBLIC_APP_URL=http://localhost:3000

# App environment
APP_ENV=development
APP_SESSION_SECRET=
APPSOLUX_AUTH_SECRET=
APPSOLUX_AUTH_PROVIDER=current
APPSOLUX_ENABLE_DEV_SESSION=true
APPSOLUX_DEV_EMAIL=admin@appsolux.com
APPSOLUX_DEV_PASSWORD=
APPSOLUX_DEV_NAME=Appsolux Admin
APPSOLUX_DEV_TENANT_NAME=Milusk
APPSOLUX_DEV_TENANT_SLUG=milusk
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Appsolux Core DB
# PostgreSQL recommended for SaaS production.
# This database is the Appsolux SaaS source of truth for users, tenants,
# memberships, integrations and onboarding.
# IMPORTANT:
# - Do not use Chatwoot's database, for example chatwoot_prod.
# - Do not use ERPNext/Frappe databases.
# - Use an independent database such as appsolux_core.
# - Never commit real usernames, passwords, tokens or hostnames.
#
# Development example using a remote PostgreSQL host:
# DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:5432/appsolux_core?schema=public"
#
# Production/Docker/Coolify example:
# DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@appsolux-db:5432/appsolux_core?schema=public"
#
# In local development this can be empty if you only want to test UI + n8n
# without opening a database connection.
DATABASE_URL=

# In development this can be false. In production it should be true.
APPSOLUX_CORE_DB_REQUIRED=false

# n8n
N8N_BASE_URL=https://engine.appsolux.com
N8N_REGISTER_WEBHOOK_URL=https://engine.appsolux.com/webhook/appsolux-register
N8N_PROVISION_WEBHOOK_URL=https://engine.appsolux.com/webhook/appsolux-provision
N8N_WEBHOOK_SECRET=

# Chatwoot
CHATWOOT_BASE_URL=https://chat.appsolux.com
# Platform API token for provisioning accounts, users and roles.
# Used only server-side. Do not use for conversations and never expose in frontend.
# Never expose in frontend.
CHATWOOT_PLATFORM_API_TOKEN=
# SuperAdmin/human profile token for internal administration or temporary compatibility.
# Do not use as the main conversations token.
CHATWOOT_ADMIN_API_ACCESS_TOKEN=
# Appsolux Bot profile token. Used server-side for conversations, messages,
# inboxes and contacts.
CHATWOOT_BOT_API_ACCESS_TOKEN=
# Deprecated fallback for old local setups. Prefer CHATWOOT_BOT_API_ACCESS_TOKEN.
CHATWOOT_API_ACCESS_TOKEN=
# Global Chatwoot user assigned to new tenant accounts so the Application API
# token can read/write conversations for those accounts. Server-side only.
CHATWOOT_OPERATIONAL_USER_ID=
# Optional documentation/fallback email for the operational Chatwoot user.
CHATWOOT_OPERATIONAL_USER_EMAIL=

# ERPNext
ERPNEXT_BASE_URL=https://erp.appsolux.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Evolution API
EVOLUTION_API_BASE_URL=https://evolution.appsolux.com
EVOLUTION_API_KEY=
# Optional shared secret sent by Evolution webhook configuration.
EVOLUTION_WEBHOOK_SECRET=
# Logo used by Evolution native Chatwoot integration.
EVOLUTION_CHATWOOT_LOGO_URL=

# Meta
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

# Meta WhatsApp Cloud API
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=

# Meta Instagram / Messenger
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Internal
INTERNAL_API_SECRET=
