model PurchaseDocument {
  id                      String                 @id @default(cuid())
  tenantId                String
  supplierId              String?

  documentType            PurchaseDocumentType   @default(INVOICE)
  supplierDocumentNumber  String?
  accessKey               String?
  authorizationNumber     String?

  issueDate               DateTime?
  authorizationDate       DateTime?

  subtotal0               Decimal                @default(0) @db.Decimal(12, 2)
  subtotal15              Decimal                @default(0) @db.Decimal(12, 2)
  subtotalNoTax           Decimal                @default(0) @db.Decimal(12, 2)
  subtotalExempt          Decimal                @default(0) @db.Decimal(12, 2)

  discountTotal           Decimal                @default(0) @db.Decimal(12, 2)
  iceTotal                Decimal                @default(0) @db.Decimal(12, 2)
  ivaTotal                Decimal                @default(0) @db.Decimal(12, 2)
  total                   Decimal                @default(0) @db.Decimal(12, 2)

  paymentMethod           String?
  paymentTermDays         Int?
  dueDate                 DateTime?

  status                  PurchaseDocumentStatus @default(DRAFT)
  origin                  PurchaseDocumentOrigin @default(MANUAL)

  xmlPath                 String?
  ridePath                String?

  accountingCategoryId    String?
  deductibilityStatus     DeductibilityStatus    @default(UNREVIEWED)
  deductibilityReason     String?

  supplierName            String?
  supplierIdentification  String?

  notes                   String?

  createdByUserId         String
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier            LightweightSupplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  accountingCategory  PurchaseAccountingCategory? @relation(fields: [accountingCategoryId], references: [id], onDelete: SetNull)
  createdBy           User                      @relation("PurchaseDocumentsCreatedBy", fields: [createdByUserId], references: [id])
  items               PurchaseDocumentItem[]
  payments            PurchasePayment[]
  receipts            PurchaseReceipt[]
  inboxItem           PurchaseInboxItem?

  @@unique([tenantId, accessKey])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, documentType])
  @@index([tenantId, origin])
  @@index([tenantId, supplierId])
  @@index([tenantId, issueDate])
  @@index([createdByUserId])
  treasuryObligation TreasuryObligation?
  @@unique([id,tenantId])

}

model PurchaseDocumentItem {
