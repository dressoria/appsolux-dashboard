generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  invited
  disabled
}

enum TenantStatus {
  provisioning
  active
  suspended
  failed
}

enum MembershipRole {
  owner
  admin
  support
  seller
  viewer
}

enum MembershipStatus {
  active
  invited
  disabled
}

enum IntegrationProvider {
  chatwoot
  erpnext
  evolution
  n8n
  meta
}

enum IntegrationInstanceStatus {
  active
  inactive
  maintenance
}

enum TenantIntegrationStatus {
  pending
  provisioning
  active
  failed
  disabled
}

enum OnboardingStatus {
  pending
  provisioning
  ready
  failed
}

enum ProvisioningJobType {
  erpnext_dedicated_site
}

enum ProvisioningJobStatus {
  queued
  running
  succeeded
  failed
  canceled
}

enum TenantSubscriptionStatus {
  active
  trialing
  past_due
  canceled
  manual
}

enum PlanUpgradeRequestStatus {
  pending
  approved
  rejected
  canceled
}

enum CommercialPlan {
  BASIC
  PLUS
  ADVANCED
  ENTERPRISE
}

enum OperatingMode {
  CORE
  SHARED_ERP
  DEDICATED_ERP
}

enum FeatureKey {
  inventory_basic
  pos_basic
  sales_basic
  customers_basic
  reports_basic
  sri_invoicing
  sri_configuration
  inventory_advanced
  purchases
  warehouses
  kardex
  advanced_reports
  shared_erp
  dedicated_erp
  erp_provisioning
  admin_access
  beta_access
}

enum FeatureSource {
  PLAN
  ADMIN
  BETA
  MIGRATION
  SYSTEM
}

enum TenantOperationalStatus {
  active
  pending_setup
  suspended
  disabled
}

enum LightweightSaleStatus {
  open
  paid
  canceled
}

enum LightweightPaymentStatus {
  paid
  pending
  partial
}

enum LightweightPaymentMethod {
  cash
  transfer
  card
  credit
}

enum LightweightStockMovementType {
  sale
  adjustment
}

enum SriEnvironment {
  TEST
  PRODUCTION
}

enum SriConfigStatus {
  PENDING
  CONFIGURED
  DISABLED
}

enum SriSignatureStatus {
  NOT_UPLOADED
  UPLOADED_METADATA_ONLY
  READY_FOR_TESTING
  EXPIRED
}

enum SriDocumentType {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  WITHHOLDING
  REFERRAL_GUIDE
}

enum SriDocumentSourceType {
  BASIC_SALE
  ERP_SALES_INVOICE
  MANUAL
}

enum SriDocumentStatus {
  DRAFT
  READY_FOR_TESTING
  VALIDATION_ERROR
  SIGNED
  SENT
  AUTHORIZED
  REJECTED
  CANCELLED
}

enum SriSigningJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SriSubmissionJobStatus {
  QUEUED
  RUNNING
  RECEIVED
  AUTHORIZED
  REJECTED
  FAILED
  CANCELLED
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  clerkUserId        String?    @unique
  supabaseAuthUserId String?    @unique
  passwordHash       String?
  status             UserStatus @default(invited)
  emailVerifiedAt    DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  memberships               Membership[]
  onboardingRequests        OnboardingRequest[]
  auditLogs                 AuditLog[]
  requestedProvisioningJobs ProvisioningJob[]   @relation("RequestedByUser")
  requestedPlanUpgrades     PlanUpgradeRequest[] @relation("RequestedPlanUpgrades")
  reviewedPlanUpgrades      PlanUpgradeRequest[] @relation("ReviewedPlanUpgrades")
  conversationNotes ConversationNote[]
  cashClosings              CashClosing[]       @relation("CashClosingCreatedBy")
  tenantFeatureOverridesCreated TenantFeatureOverride[]
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  legalName String?
  country   String?
  currency  String?
  status    TenantStatus @default(provisioning)
  planKey   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships               Membership[]
  integrations              TenantIntegration[]
  onboardingRequests        OnboardingRequest[]
  auditLogs                 AuditLog[]
  provisioningJobs          ProvisioningJob[]
  subscriptions             TenantSubscription[]
  planUpgradeRequests       PlanUpgradeRequest[]
  lightweightProducts       LightweightProduct[]
  lightweightCustomers      LightweightCustomer[]
  lightweightSales          LightweightSale[]
  lightweightStockMovements LightweightStockMovement[]
  conversationNotes         ConversationNote[]
  cashClosings              CashClosing[]
  sriProfile                SriTaxpayerProfile?
  sriEstablishments         SriEstablishment[]
  sriIssuePoints            SriIssuePoint[]
  sriDocumentSequences      SriDocumentSequence[]
  sriSignatureConfig        SriSignatureConfig?
  sriDocuments              SriDocument[]
  sriSigningJobs            SriSigningJob[]
  sriSubmissionJobs         SriSubmissionJob[]
  operationalConfig         TenantOperationalConfig?
  featureOverrides          TenantFeatureOverride[]
}

model Plan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  limits      Json
  features    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id                  String                   @id @default(cuid())
  tenantId            String
  planId              String
  status              TenantSubscriptionStatus @default(active)
  startedAt           DateTime                 @default(now())
  trialEndsAt         DateTime?
  currentPeriodEndsAt DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

model TenantOperationalConfig {
  id                  String                  @id @default(cuid())
  tenantId            String                  @unique
  operatingMode       OperatingMode           @default(CORE)
  status              TenantOperationalStatus @default(active)
  sriEnabled          Boolean                 @default(false)
  sharedErpEnabled    Boolean                 @default(false)
  dedicatedErpEnabled Boolean                 @default(false)
  suspendedAt         DateTime?
  notes               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([operatingMode])
  @@index([status])
}

model TenantFeatureOverride {
  id          String        @id @default(cuid())
  tenantId    String
  featureKey  FeatureKey
  enabled     Boolean
  source      FeatureSource @default(ADMIN)
  notes       String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, featureKey])
  @@index([tenantId])
  @@index([featureKey])
  @@index([source])
}

model PlanUpgradeRequest {
  id               String                   @id @default(cuid())
  tenantId         String
  requestedPlanKey String
  currentPlanKey   String?
  status           PlanUpgradeRequestStatus @default(pending)
  message          String?
  adminNote        String?
  requestedById    String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy User?  @relation("RequestedPlanUpgrades", fields: [requestedById], references: [id])
  reviewedBy  User?  @relation("ReviewedPlanUpgrades", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([requestedPlanKey])
  @@index([requestedById])
  @@index([reviewedById])
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model LightweightProduct {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  price     Decimal   @db.Decimal(12, 2)
  cost      Decimal?  @db.Decimal(12, 2)
  stock     Int       @default(0)
  minStock  Int?
  barcode   String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItems      LightweightSaleItem[]
  stockMovements LightweightStockMovement[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, barcode])
}

model LightweightCustomer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  address   String?
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales  LightweightSale[]

  @@index([tenantId])
  @@index([tenantId, name])
}

model LightweightSale {
  id            String                   @id @default(cuid())
  tenantId      String
  customerId    String?
  status        LightweightSaleStatus    @default(paid)
  total         Decimal                  @db.Decimal(12, 2)
  paymentStatus LightweightPaymentStatus @default(paid)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer LightweightCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    LightweightSaleItem[]
  payments LightweightPayment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([createdAt])
}

model LightweightSaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  sale    LightweightSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product LightweightProduct @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model LightweightPayment {
  id        String                   @id @default(cuid())
  saleId    String
  method    LightweightPaymentMethod
  amount    Decimal                  @db.Decimal(12, 2)
  createdAt DateTime                 @default(now())

  sale LightweightSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([method])
}

model LightweightStockMovement {
  id        String                       @id @default(cuid())
  tenantId  String
  productId String
  type      LightweightStockMovementType
  quantity  Int
  createdAt DateTime                     @default(now())

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product LightweightProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@index([type])
}

model ProvisioningJob {
  id                String                @id @default(cuid())
  tenantId          String
  requestedByUserId String?
  type              ProvisioningJobType
  status            ProvisioningJobStatus @default(queued)
  priority          Int                   @default(100)
  attempts          Int                   @default(0)
  maxAttempts       Int                   @default(3)
  payload           Json?
  result            Json?
  lastError         String?
  lockedAt          DateTime?
  lockedBy          String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByUser User?  @relation("RequestedByUser", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([type, status])
  @@index([createdAt])
}

model IntegrationInstance {
  id        String                    @id @default(cuid())
  provider  IntegrationProvider
  name      String                    @unique
  baseUrl   String?
  status    IntegrationInstanceStatus @default(active)
  metadata  Json?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  tenantIntegrations TenantIntegration[]
}

model TenantIntegration {
  id                   String                  @id @default(cuid())
  tenantId             String
  instanceId           String
  provider             IntegrationProvider
  externalAccountId    String?
  externalSiteName     String?
  externalCompanyId    String?
  externalInstanceName String?
  status               TenantIntegrationStatus @default(pending)
  config               Json?
  lastError            String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance IntegrationInstance @relation(fields: [instanceId], references: [id])

  @@unique([tenantId, provider])
  @@index([instanceId])
}

model OnboardingRequest {
  id          String           @id @default(cuid())
  email       String
  companyName String
  contactName String?
  phone       String?
  country     String?
  currency    String?
  planKey     String?
  status      OnboardingStatus @default(pending)
  tenantId    String?
  userId      String?
  payload     Json?
  lastError   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
}

model ConversationNote {
  id                     String   @id @default(cuid())
  tenantId               String
  conversationExternalId String
  authorUserId           String?
  body                   String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, conversationExternalId])
  @@index([createdAt])
  @@index([authorUserId])
}

model CashClosing {
  id                     String   @id @default(cuid())
  tenantId               String
  erpCompanyName         String?
  cashAccountName        String?
  date                   DateTime
  closedAt               DateTime @default(now())
  expectedCashAmount     Decimal  @default(0) @db.Decimal(12, 2)
  expectedTransferAmount Decimal  @default(0) @db.Decimal(12, 2)
  expectedCardAmount     Decimal  @default(0) @db.Decimal(12, 2)
  expectedOtherAmount    Decimal  @default(0) @db.Decimal(12, 2)
  expectedTotalAmount    Decimal  @default(0) @db.Decimal(12, 2)
  countedCashAmount      Decimal  @default(0) @db.Decimal(12, 2)
  differenceAmount       Decimal  @default(0) @db.Decimal(12, 2)
  notes                  String?
  status                 String   @default("closed")
  createdByUserId        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("CashClosingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([createdByUserId])
  @@index([status])
}

model SriTaxpayerProfile {
  id                         String          @id @default(cuid())
  tenantId                   String          @unique
  legalName                  String
  tradeName                  String?
  ruc                        String
  environment                SriEnvironment  @default(TEST)
  accountingRequired         Boolean         @default(false)
  specialTaxpayerNumber      String?
  withholdingAgentResolution String?
  status                     SriConfigStatus @default(PENDING)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  establishments  SriEstablishment[]
  signatureConfig SriSignatureConfig?

  @@index([tenantId])
  @@index([ruc])
}

model SriEstablishment {
  id        String          @id @default(cuid())
  tenantId  String
  profileId String
  code      String
  name      String
  address   String
  isMain    Boolean         @default(false)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile     SriTaxpayerProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  issuePoints SriIssuePoint[]
  sequences   SriDocumentSequence[]
  documents   SriDocument[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([profileId])
}

model SriIssuePoint {
  id              String   @id @default(cuid())
  tenantId        String
  establishmentId String
  code            String
  name            String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  establishment SriEstablishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  sequences     SriDocumentSequence[]
  documents     SriDocument[]

  @@unique([establishmentId, code])
  @@index([tenantId])
  @@index([establishmentId])
}

model SriDocumentSequence {
  id              String          @id @default(cuid())
  tenantId        String
  establishmentId String
  issuePointId    String
  documentType    SriDocumentType
  currentNumber   Int             @default(1)
  startNumber     Int             @default(1)
  maxNumber       Int?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  establishment SriEstablishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  issuePoint    SriIssuePoint    @relation(fields: [issuePointId], references: [id], onDelete: Cascade)

  @@unique([tenantId, establishmentId, issuePointId, documentType])
  @@index([tenantId])
  @@index([establishmentId])
  @@index([issuePointId])
}

model SriSignatureConfig {
  id                    String             @id @default(cuid())
  tenantId              String             @unique
  profileId             String             @unique
  status                         SriSignatureStatus @default(NOT_UPLOADED)
  certificateFileName            String?
  certificateUploadedAt          DateTime?
  expiresAt                      DateTime?
  issuerName                     String?
  subjectName                    String?
  serialNumber                   String?
  fingerprintSha256              String?
  encryptedCertificateStorageKey String?
  encryptedCertificatePassword   String?
  encryptionKeyVersion           String?
  createdAt                      DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile SriTaxpayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model SriDocument {
  id                     String                @id @default(cuid())
  tenantId               String
  sourceType             SriDocumentSourceType
  sourceId               String?
  documentType           SriDocumentType
  status                 SriDocumentStatus     @default(DRAFT)
  environment            SriEnvironment        @default(TEST)
  establishmentId        String
  issuePointId           String
  sequenceId             String?
  sequentialNumber       Int?
  accessKey              String?
  customerName           String
  customerIdentification String?
  customerEmail          String?
  customerPhone          String?
  subtotal               Decimal               @db.Decimal(12, 2)
  taxTotal               Decimal               @default(0) @db.Decimal(12, 2)
  discountTotal          Decimal               @default(0) @db.Decimal(12, 2)
  grandTotal             Decimal               @db.Decimal(12, 2)
  currency               String                @default("USD")
  issuedAt               DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  establishment SriEstablishment @relation(fields: [establishmentId], references: [id])
  issuePoint    SriIssuePoint    @relation(fields: [issuePointId], references: [id])
  lines         SriDocumentLine[]
  signingJobs   SriSigningJob[]
  submissionJobs SriSubmissionJob[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, sourceType, sourceId])
  @@index([establishmentId])
  @@index([issuePointId])
  @@index([createdAt])
}

model SriSigningJob {
  id                    String              @id @default(cuid())
  tenantId              String
  documentId            String
  status                SriSigningJobStatus @default(QUEUED)
  priority              Int                 @default(0)
  attempts              Int                 @default(0)
  maxAttempts           Int                 @default(3)
  lockedAt              DateTime?
  lockedBy              String?
  runAfter              DateTime?
  startedAt             DateTime?
  finishedAt            DateTime?
  errorCode             String?
  errorMessage          String?
  unsignedXmlHash       String?
  signedXmlStorageKey   String?
  signedXmlHash         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document SriDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
  @@index([status])
  @@index([runAfter])
  @@index([lockedAt])
  @@index([status, runAfter])
  @@index([tenantId, documentId])
}

model SriSubmissionJob {
  id                     String                 @id @default(cuid())
  tenantId               String
  documentId             String
  status                 SriSubmissionJobStatus @default(QUEUED)
  environment            SriEnvironment         @default(TEST)
  priority               Int                    @default(0)
  attempts               Int                    @default(0)
  maxAttempts            Int                    @default(3)
  lockedAt               DateTime?
  lockedBy               String?
  runAfter               DateTime?
  startedAt              DateTime?
  finishedAt             DateTime?
  receivedAt             DateTime?
  authorizedAt           DateTime?
  sriReceiptStatus       String?
  sriAuthorizationStatus String?
  sriAuthorizationNumber String?
  sriAccessKey           String?
  sriResponseRaw         Json?
  errorCode              String?
  errorMessage           String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document SriDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
  @@index([status])
  @@index([runAfter])
  @@index([status, runAfter])
  @@index([tenantId, documentId])
}

model SriDocumentLine {
  id             String   @id @default(cuid())
  documentId     String
  itemName       String
  itemCode       String?
  quantity       Decimal  @db.Decimal(12, 4)
  unitPrice      Decimal  @db.Decimal(12, 4)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  document SriDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
