model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  clerkUserId        String?    @unique
  supabaseAuthUserId String?    @unique
  passwordHash       String?
  status             UserStatus @default(invited)
  emailVerifiedAt    DateTime?
  trialConsumedAt    DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  memberships                          Membership[]
  onboardingRequests                   OnboardingRequest[]
  auditLogs                            AuditLog[]
  requestedProvisioningJobs            ProvisioningJob[]            @relation("RequestedByUser")
  requestedPlanUpgrades                PlanUpgradeRequest[]         @relation("RequestedPlanUpgrades")
  reviewedPlanUpgrades                 PlanUpgradeRequest[]         @relation("ReviewedPlanUpgrades")
  conversationNotes                    ConversationNote[]
  cashClosings                         CashClosing[]                @relation("CashClosingCreatedBy")
  tenantFeatureOverridesCreated        TenantFeatureOverride[]
  requestedBusinessSuiteActivationJobs BusinessSuiteActivationJob[] @relation("RequestedBusinessSuiteActivationJobs")
  aiInvoiceDrafts                      AiInvoiceDraft[]
  salesImportBatches                   SalesImportBatch[]
  purchaseDocumentsCreated             PurchaseDocument[]   @relation("PurchaseDocumentsCreatedBy")
  purchaseReceiptsCreated              PurchaseReceipt[]    @relation("PurchaseReceiptsCreatedBy")
  purchaseSyncJobsRequested            PurchaseSriSyncJob[] @relation("PurchaseSyncJobsRequestedBy")
  homePreferences                      UserHomePreference[]
}

model Tenant {
  id                          String       @id @default(cuid())
  name                        String
  slug                        String       @unique
  legalName                   String?
  taxIdentificationType       String?
  taxIdentificationValue      String?
  taxIdentificationNormalized String?      @unique
  phone                       String?
  contactEmail                String?
  province                    String?
  city                        String?
  address                     String?
  country                     String?
  currency                    String?
  status                      TenantStatus @default(provisioning)
  planKey                     String?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  memberships                  Membership[]
  integrations                 TenantIntegration[]
  onboardingRequests           OnboardingRequest[]
  auditLogs                    AuditLog[]
  provisioningJobs             ProvisioningJob[]
  subscriptions                TenantSubscription[]
  planUpgradeRequests          PlanUpgradeRequest[]
  lightweightProducts          LightweightProduct[]
  lightweightProductCategories LightweightProductCategory[]
  lightweightCustomers         LightweightCustomer[]
  lightweightSuppliers         LightweightSupplier[]
  lightweightSales             LightweightSale[]
  lightweightProformas         LightweightProforma[]
  lightweightStockMovements    LightweightStockMovement[]
  conversationNotes            ConversationNote[]
  cashClosings                 CashClosing[]
  sriProfile                   SriTaxpayerProfile?
  sriEstablishments            SriEstablishment[]
  sriIssuePoints               SriIssuePoint[]
  sriDocumentSequences         SriDocumentSequence[]
  sriSignatureConfig           SriSignatureConfig?
  sriDocuments                 SriDocument[]
  sriSigningJobs               SriSigningJob[]
  sriSubmissionJobs            SriSubmissionJob[]
  operationalConfig            TenantOperationalConfig?
  featureOverrides             TenantFeatureOverride[]
  businessSuiteActivationJobs  BusinessSuiteActivationJob[]
  erpProductPricings           ErpProductPricing[]
  quickInvoiceDrafts           QuickInvoiceDraft[]
  businessSettings             BusinessSettings?
  aiInvoiceDrafts              AiInvoiceDraft[]
  aiInvoiceProposals           AiInvoiceProposal[]
  salesImportBatches           SalesImportBatch[]
  purchaseDocuments            PurchaseDocument[]
  purchaseReceipts             PurchaseReceipt[]
  purchaseAccountingCategories PurchaseAccountingCategory[]
  purchaseClassificationRules  PurchaseClassificationRule[]
  purchaseInboxItems           PurchaseInboxItem[]
  purchaseSriSyncConfig        PurchaseSriSyncConfig?
  purchaseSriCredential        PurchaseSriCredential?
  purchaseSriSyncJobs          PurchaseSriSyncJob[]
  purchaseSriSyncRuns          PurchaseSriSyncRun[]
  treasuryAccounts TreasuryAccount[]
  treasuryObligations TreasuryObligation[]
  postdatedChecks PostdatedCheck[]
  accountingPlans              AccountingPlan[]
  accountingAccounts           AccountingAccount[]
  accountingAccountMappings    AccountingAccountMapping[]
  taxWithholdingAccountMappings TaxWithholdingAccountMapping[]
  accountingCostExpenseConcepts AccountingCostExpenseConcept[]
  accountingCostCenters        AccountingCostCenter[]
  accountingPeriods            AccountingPeriod[]
  accountingJournalEntries     AccountingJournalEntry[]
  accountingJournalLines       AccountingJournalLine[]
  accountingSettings           AccountingSettings?
  inventoryBrands              InventoryBrand[]
  inventoryUnits               InventoryUnit[]
  inventoryWarehouses          InventoryWarehouse[]
  inventoryStockBalances       InventoryStockBalance[]
  inventoryMovements           InventoryMovement[]
  inventoryPhysicalCounts      InventoryPhysicalCount[]
  inventoryTransfers           InventoryTransfer[]
  inventoryVehicles            InventoryVehicle[]
  shipmentGuides               ShipmentGuide[]
  inventoryOrders              InventoryOrder[]
  productPriceChanges          ProductPriceChange[]
  inventorySettings            InventorySettings?
  sriCancellationRequests      SriCancellationRequest[]
  userHomePreferences          UserHomePreference[]
  salesInvoiceDrafts           SalesInvoiceDraft[]
}

model Plan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  limits      Json
  features    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id                       String                   @id @default(cuid())
  tenantId                 String
  planId                   String
  status                   TenantSubscriptionStatus @default(active)
  billingMode              TenantBillingMode        @default(manual)
  startedAt                DateTime                 @default(now())
  trialEndsAt              DateTime?
  currentPeriodEndsAt      DateTime?
  graceEndsAt              DateTime?
  suspendedAt              DateTime?
  stripeCustomerId         String?                  @unique
  stripeSubscriptionId     String?                  @unique
  stripePriceId            String?
  billingInterval          BillingInterval?
  currentPeriodStartsAt    DateTime?
  cancelAtPeriodEnd        Boolean                  @default(false)
  lastStripeEventCreatedAt Int?
  providerCustomerId       String?
  providerSubscriptionId   String?
  providerPriceId          String?
  providerLastEventAt      DateTime?
  providerMetadata         Json?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([providerSubscriptionId])
}

model BillingWebhookEvent {
  id              String               @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  status          BillingWebhookStatus @default(processing)
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([provider, externalEventId])
  @@index([status])
  @@index([createdAt])
}

model TenantOperationalConfig {
  id                  String                  @id @default(cuid())
  tenantId            String                  @unique
  operatingMode       OperatingMode           @default(CORE)
  status              TenantOperationalStatus @default(active)
  businessSuiteStatus BusinessSuiteStatus     @default(locked)
  sriEnabled          Boolean                 @default(false)
  sharedErpEnabled    Boolean                 @default(false)
  dedicatedErpEnabled Boolean                 @default(false)
  suspendedAt         DateTime?
  notes               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([operatingMode])
  @@index([status])
  @@index([businessSuiteStatus])
}

model BusinessSuiteActivationJob {
  id                String                           @id @default(cuid())
  tenantId          String
  requestedByUserId String?
  sourceMode        BusinessSuitePlanMode
  targetMode        BusinessSuitePlanMode
  businessSuiteMode BusinessSuiteAccessMode
  status            BusinessSuiteActivationJobStatus @default(queued)
  dryRun            Boolean                          @default(true)
  summary           Json?
  errorMessage      String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByUser User?  @relation("RequestedBusinessSuiteActivationJobs", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([requestedByUserId])
  @@index([status])
  @@index([tenantId, status])
  @@index([createdAt])
}

model TenantFeatureOverride {
  id          String        @id @default(cuid())
  tenantId    String
  featureKey  FeatureKey
  enabled     Boolean
  source      FeatureSource @default(ADMIN)
  notes       String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, featureKey])
  @@index([tenantId])
  @@index([featureKey])
  @@index([source])
}

model PlanUpgradeRequest {
  id               String                   @id @default(cuid())
  tenantId         String
  requestedPlanKey String
  currentPlanKey   String?
  status           PlanUpgradeRequestStatus @default(pending)
  message          String?
  adminNote        String?
  requestedById    String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy User?  @relation("RequestedPlanUpgrades", fields: [requestedById], references: [id])
  reviewedBy  User?  @relation("ReviewedPlanUpgrades", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([requestedPlanKey])
  @@index([requestedById])
  @@index([reviewedById])
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model LightweightProduct {
  id             String                 @id @default(cuid())
  tenantId       String
  name           String
  price          Decimal                @db.Decimal(12, 2)
  cost           Decimal?               @db.Decimal(12, 2)
  stock          Int                    @default(0)
  minStock       Int?
  barcode        String?
  expiresAt      DateTime?
  taxRate        Decimal                @default(0) @db.Decimal(5, 2)
  type           LightweightProductType @default(PRODUCT)
  primaryCode    String?
  auxiliaryCode  String?
  description    String?
  price2         Decimal?               @db.Decimal(12, 2)
  price3         Decimal?               @db.Decimal(12, 2)
  isActive       Boolean                @default(true)
  trackInventory Boolean                @default(true)
  unit           LightweightProductUnit @default(UNIT)
  categoryId     String?
  iceEnabled     Boolean                @default(false)
  iceCode        String?
  iceRate        Decimal?               @db.Decimal(7, 4)
  price4         Decimal?               @db.Decimal(12, 2)
  auxiliaryTransportCode String?
  imageStorageKey        String?
  defaultWarehouseId     String?
  unitId                 String?
  brandId                String?
  salesAccountId         String?
  inventoryAccountId     String?
  cogsAccountId          String?
  purchaseAccountId      String?
  taxCategory            ProductTaxCategory?
  color                  String?
  additionalComment      String?
  isProcessed            Boolean                @default(false)
  warrantyDuration       Int?
  warrantyUnit           WarrantyUnit?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItems      LightweightSaleItem[]
  stockMovements LightweightStockMovement[]
  category       LightweightProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comboItems     LightweightComboItem[]      @relation("ComboProduct")
  componentOf    LightweightComboItem[]      @relation("ComboComponent")
  purchaseDocumentItems PurchaseDocumentItem[]
  purchaseReceiptItems  PurchaseReceiptItem[]
  defaultWarehouse      InventoryWarehouse?    @relation("ProductDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  inventoryUnit         InventoryUnit?         @relation("ProductUnit", fields: [unitId], references: [id], onDelete: SetNull)
  brand                 InventoryBrand?        @relation("ProductBrand", fields: [brandId], references: [id], onDelete: SetNull)
  salesAccount          AccountingAccount?     @relation("ProductSalesAccount", fields: [salesAccountId], references: [id], onDelete: SetNull)
  inventoryAccount      AccountingAccount?     @relation("ProductInventoryAccount", fields: [inventoryAccountId], references: [id], onDelete: SetNull)
  cogsAccount           AccountingAccount?     @relation("ProductCogsAccount", fields: [cogsAccountId], references: [id], onDelete: SetNull)
  purchaseAccount       AccountingAccount?     @relation("ProductPurchaseAccount", fields: [purchaseAccountId], references: [id], onDelete: SetNull)
  stockBalances         InventoryStockBalance[]
  inventoryMovements    InventoryMovement[]
  physicalCountItems    InventoryPhysicalCountItem[]
  transferItems         InventoryTransferItem[]
  shipmentGuideItems    ShipmentGuideItem[]
  orderItems            InventoryOrderItem[]
  priceChanges          ProductPriceChange[]

  @@unique([tenantId, primaryCode])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, barcode])
  @@index([tenantId, type, isActive])
  @@index([brandId])
  @@index([unitId])
}

model LightweightProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products LightweightProduct[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model LightweightComboItem {
  id                 String   @id @default(cuid())
  comboProductId     String
  componentProductId String
  quantity           Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  comboProduct     LightweightProduct @relation("ComboProduct", fields: [comboProductId], references: [id], onDelete: Cascade)
  componentProduct LightweightProduct @relation("ComboComponent", fields: [componentProductId], references: [id], onDelete: Restrict)

  @@unique([comboProductId, componentProductId])
  @@index([componentProductId])
}

model LightweightCustomer {
  id                 String                                 @id @default(cuid())
  tenantId           String
  name               String
  tradeName          String?
  phone              String?
  phoneNumbers       String[]                               @default([])
  email              String?
  additionalEmails   String[]                               @default([])
  address            String?
  country            String                                 @default("Ecuador")
  province           String?
  city               String?
  parish             String?
  sector             String?
  zone               String?
  customerType       String?
  customerOrigin     String?
  groupName          String?
  assignedSellerId   String?
  isRelated          Boolean                                @default(false)
  isForeign          Boolean                                @default(false)
  invoiceThirdParty  Boolean                                @default(false)
  identificationType LightweightCustomerIdentificationType?
  identification     String?
