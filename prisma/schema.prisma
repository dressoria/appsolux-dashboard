  loginSucceeded             Boolean?
  humanVerificationDetected  Boolean                   @default(false)
  documentsFound             Int                       @default(0)
  documentsDownloaded        Int                       @default(0)
  documentsImported          Int                       @default(0)
  documentsSkipped           Int                       @default(0)
  documentsFailed            Int                       @default(0)
