generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  invited
  disabled
}

enum TenantStatus {
  provisioning
  active
  suspended
  failed
}

enum MembershipRole {
  owner
  admin
  support
  seller
  viewer
}

enum MembershipStatus {
  active
  invited
  disabled
}

enum IntegrationProvider {
  chatwoot
  erpnext
  evolution
  n8n
  meta
}

enum IntegrationInstanceStatus {
  active
  inactive
  maintenance
}

enum TenantIntegrationStatus {
  pending
  provisioning
  active
  failed
  disabled
}

enum OnboardingStatus {
  pending
  provisioning
  ready
  failed
}

enum ProvisioningJobType {
  erpnext_dedicated_site
}

enum ProvisioningJobStatus {
  queued
  running
  succeeded
  failed
  canceled
}

enum TenantSubscriptionStatus {
  active
  trialing
  past_due
  canceled
  manual
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String?
  status          UserStatus @default(invited)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships               Membership[]
  onboardingRequests        OnboardingRequest[]
  auditLogs                 AuditLog[]
  requestedProvisioningJobs ProvisioningJob[]   @relation("RequestedByUser")
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  legalName String?
  country   String?
  currency  String?
  status    TenantStatus @default(provisioning)
  planKey   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships        Membership[]
  integrations       TenantIntegration[]
  onboardingRequests OnboardingRequest[]
  auditLogs          AuditLog[]
  provisioningJobs   ProvisioningJob[]
  subscriptions      TenantSubscription[]
}

model Plan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  limits      Json
  features    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id                  String                   @id @default(cuid())
  tenantId            String
  planId              String
  status              TenantSubscriptionStatus @default(active)
  startedAt           DateTime                 @default(now())
  trialEndsAt         DateTime?
  currentPeriodEndsAt DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model ProvisioningJob {
  id                String                @id @default(cuid())
  tenantId          String
  requestedByUserId String?
  type              ProvisioningJobType
  status            ProvisioningJobStatus @default(queued)
  priority          Int                   @default(100)
  attempts          Int                   @default(0)
  maxAttempts       Int                   @default(3)
  payload           Json?
  result            Json?
  lastError         String?
  lockedAt          DateTime?
  lockedBy          String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByUser User?  @relation("RequestedByUser", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([type, status])
  @@index([createdAt])
}

model IntegrationInstance {
  id        String                    @id @default(cuid())
  provider  IntegrationProvider
  name      String                    @unique
  baseUrl   String?
  status    IntegrationInstanceStatus @default(active)
  metadata  Json?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  tenantIntegrations TenantIntegration[]
}

model TenantIntegration {
  id                   String                  @id @default(cuid())
  tenantId             String
  instanceId           String
  provider             IntegrationProvider
  externalAccountId    String?
  externalSiteName     String?
  externalCompanyId    String?
  externalInstanceName String?
  status               TenantIntegrationStatus @default(pending)
  config               Json?
  lastError            String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance IntegrationInstance @relation(fields: [instanceId], references: [id])

  @@unique([tenantId, provider])
  @@index([instanceId])
}

model OnboardingRequest {
  id          String           @id @default(cuid())
  email       String
  companyName String
  contactName String?
  phone       String?
  country     String?
  currency    String?
  planKey     String?
  status      OnboardingStatus @default(pending)
  tenantId    String?
  userId      String?
  payload     Json?
  lastError   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
}
