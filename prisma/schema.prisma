// Facturom Treasury Core — additive; historical payments remain the source of payments.
enum TreasuryAccountType {
  CASH
  BANK
  CARD
}

enum TreasuryMovementDirection {
  IN
  OUT
}

enum TreasuryMovementType {
  OPENING_BALANCE
  SALE_COLLECTION
  PURCHASE_PAYMENT
  CASH_IN
  CASH_OUT
  BANK_DEPOSIT
  BANK_WITHDRAWAL
  BANK_TRANSFER
  CUSTOMER_ADVANCE
  SUPPLIER_ADVANCE
  CARD_COLLECTION
  CARD_FEE
  CARD_SETTLEMENT
  CHECK_RECEIVED
  CHECK_DEPOSIT
  CHECK_CLEARED
  CHECK_BOUNCED
  ADJUSTMENT
  OTHER
}

enum TreasuryMovementStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RECONCILED
}

enum TreasurySourceType {
  MANUAL
  SALE_PAYMENT
  PURCHASE_PAYMENT
  OBLIGATION
  TRANSFER
  ADVANCE
  CARD
  CHECK
  REVERSAL
}

enum CashSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum TreasuryObligationType {
  RECEIVABLE
  PAYABLE
}

enum TreasuryObligationStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum TreasuryAdvanceType {
  CUSTOMER
  SUPPLIER
}

enum TreasuryAdvanceStatus {
  AVAILABLE
  PARTIALLY_APPLIED
  APPLIED
  CANCELLED
}

enum PostdatedCheckStatus {
  PENDING
  READY_TO_DEPOSIT
  DEPOSITED
  CLEARED
  BOUNCED
  CANCELLED
  DELIVERED
}

enum BankAccountType {
  CHECKING
  SAVINGS
  OTHER
}

enum BankReconciliationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BankStatementLineStatus {
  UNMATCHED
  MATCHED
}

enum CardTransactionStatus {
  PENDING
  SETTLED
  REVERSED
  DISPUTED
  CANCELLED
}

model TreasuryAccount {
  id                      String               @id @default(cuid())
  tenantId                String
  type                    TreasuryAccountType
  name                    String
  code                    String?
  active                  Boolean              @default(true)
  currency                String               @default("USD")
  defaultAccount          Boolean              @default(false)
  openingBalance          Decimal              @default(0) @db.Decimal(14, 2)
  openingDate             DateTime             @default(now())
  responsibleName         String?
  bankName                String?
  accountName             String?
  accountNumberMasked     String?
  bankAccountType         BankAccountType?
  provider                String?
  settlementBankAccountId String?
  feePercentage           Decimal              @default(0) @db.Decimal(7, 4)
  fixedFee                Decimal              @default(0) @db.Decimal(14, 2)
  settlementDays          Int                  @default(2)
  createdByUserId         String
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  settlementBank          TreasuryAccount?     @relation("SettlementBank", fields: [settlementBankAccountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  cardChannels            TreasuryAccount[]    @relation("SettlementBank")
  movements               TreasuryMovement[]
  sessions                CashSession[]
  reconciliations         BankReconciliation[]
  statementLines          BankStatementLine[]
  advances                TreasuryAdvance[]
  cardTransactions        CardTransaction[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, type, active])
}

model CashSession {
  id                    String             @id @default(cuid())
  tenantId              String
  cashAccountId         String
  openedByUserId        String
  closedByUserId        String?
  openedAt              DateTime           @default(now())
  closedAt              DateTime?
  openingAmount         Decimal            @db.Decimal(14, 2)
  expectedClosingAmount Decimal?           @db.Decimal(14, 2)
  countedClosingAmount  Decimal?           @db.Decimal(14, 2)
  differenceAmount      Decimal?           @db.Decimal(14, 2)
  status                CashSessionStatus  @default(OPEN)
  notes                 String?
  cashClosingId         String?            @unique
  cashAccount           TreasuryAccount    @relation(fields: [cashAccountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  cashClosing           CashClosing?       @relation(fields: [cashClosingId], references: [id], onDelete: Restrict)
  movements             TreasuryMovement[]

  @@unique([id, tenantId])
  @@index([tenantId, cashAccountId, status])
}

model TreasuryObligation {
  id                 String                   @id @default(cuid())
  tenantId           String
  type               TreasuryObligationType
  customerId         String?
  supplierId         String?
  saleId             String?                  @unique
  purchaseDocumentId String?                  @unique
  documentType       String                   @default("OPENING_OBLIGATION")
  documentNumber     String?
  issueDate          DateTime
  dueDate            DateTime
  originalAmount     Decimal                  @db.Decimal(14, 2)
  paidAmount         Decimal                  @default(0) @db.Decimal(14, 2)
  balance            Decimal                  @db.Decimal(14, 2)
  status             TreasuryObligationStatus @default(OPEN)
  externalReference  String
  importBatchId      String?
  notes              String?
  createdByUserId    String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer           LightweightCustomer?     @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  supplier           LightweightSupplier?     @relation(fields: [supplierId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sale               LightweightSale?         @relation(fields: [saleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  purchaseDocument   PurchaseDocument?        @relation(fields: [purchaseDocumentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  movements          TreasuryMovement[]
  applications       AdvanceApplication[]
  checks             PostdatedCheck[]
  cardTransactions   CardTransaction[]

  @@unique([saleId, tenantId])
  @@unique([purchaseDocumentId, tenantId])
  @@unique([id, tenantId])
  @@unique([tenantId, type, externalReference])
  @@index([tenantId, type, status, dueDate])
}

model TreasuryMovement {
  id                 String                    @id @default(cuid())
  tenantId           String
  accountId          String
  cashSessionId      String?
  obligationId       String?
  movementType       TreasuryMovementType
  direction          TreasuryMovementDirection
  amount             Decimal                   @db.Decimal(14, 2)
  date               DateTime
  description        String
  reference          String?
  sourceType         TreasurySourceType
  sourceId           String
  transferGroupId    String?
  counterpartyType   TreasuryAdvanceType?
  counterpartyId     String?
  status             TreasuryMovementStatus    @default(CONFIRMED)
  salePaymentId      String?                   @unique
  purchasePaymentId  String?                   @unique
  reversalOfId       String?                   @unique
  createdByUserId    String
  cancelledByUserId  String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  account            TreasuryAccount           @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  cashSession        CashSession?              @relation(fields: [cashSessionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  obligation         TreasuryObligation?       @relation(fields: [obligationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  salePayment        LightweightPayment?       @relation(fields: [salePaymentId], references: [id], onDelete: Restrict)
  purchasePayment    PurchasePayment?          @relation(fields: [purchasePaymentId], references: [id], onDelete: Restrict)
  reversalOf         TreasuryMovement?         @relation("MovementReversal", fields: [reversalOfId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reversal           TreasuryMovement?         @relation("MovementReversal")
  statementLine      BankStatementLine?

  @@unique([reversalOfId, tenantId])
  @@unique([id, tenantId])
  @@unique([tenantId, sourceType, sourceId, movementType, direction])
  @@index([tenantId, accountId, date])
  @@index([tenantId, transferGroupId])
}

model PostdatedCheck {
  id                      String                 @id @default(cuid())
  tenantId                String
  direction               TreasuryObligationType
  checkNumber             String
  bankName                String
  bankAccountNumberMasked String?
  issuerName              String
  issuerIdentification    String?
  beneficiaryName         String?
  amount                  Decimal                @db.Decimal(14, 2)
  issueDate               DateTime
  dueDate                 DateTime
  status                  PostdatedCheckStatus   @default(PENDING)
  customerId              String?
  supplierId              String?
  obligationId            String?
  notes                   String?
  createdByUserId         String
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  obligation              TreasuryObligation?    @relation(fields: [obligationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer                LightweightCustomer?   @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  supplier                LightweightSupplier?   @relation(fields: [supplierId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, direction, bankName, checkNumber, issuerName])
  @@index([tenantId, status, dueDate])
}

model BankReconciliation {
  id                      String                   @id @default(cuid())
  tenantId                String
  bankAccountId           String
  periodStart             DateTime
  periodEnd               DateTime
  dateToleranceDays       Int                      @default(2)
  statementOpeningBalance Decimal                  @db.Decimal(14, 2)
  statementClosingBalance Decimal                  @db.Decimal(14, 2)
  systemOpeningBalance    Decimal                  @db.Decimal(14, 2)
  systemClosingBalance    Decimal                  @db.Decimal(14, 2)
  difference              Decimal                  @db.Decimal(14, 2)
  status                  BankReconciliationStatus @default(DRAFT)
  createdByUserId         String
  createdAt               DateTime                 @default(now())
  completedAt             DateTime?
  bankAccount             TreasuryAccount          @relation(fields: [bankAccountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lines                   BankStatementLine[]

  @@unique([id, tenantId])
  @@index([tenantId, bankAccountId, periodStart, periodEnd])
}

model BankStatementLine {
  id                String                    @id @default(cuid())
  tenantId          String
  bankAccountId     String
  reconciliationId  String
  date              DateTime
  description       String
  reference         String?
  amount            Decimal                   @db.Decimal(14, 2)
  direction         TreasuryMovementDirection
  matchedMovementId String?                   @unique
  status            BankStatementLineStatus   @default(UNMATCHED)
  importKey         String
  createdAt         DateTime                  @default(now())
  bankAccount       TreasuryAccount           @relation(fields: [bankAccountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reconciliation    BankReconciliation        @relation(fields: [reconciliationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  matchedMovement   TreasuryMovement?         @relation(fields: [matchedMovementId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([matchedMovementId, tenantId])
  @@unique([id, tenantId])
  @@unique([tenantId, bankAccountId, importKey])
  @@index([tenantId, reconciliationId, status])
}

model TreasuryAdvance {
  id                String                   @id @default(cuid())
  tenantId          String
  type              TreasuryAdvanceType
  customerId        String?
  supplierId        String?
  amount            Decimal                  @db.Decimal(14, 2)
  appliedAmount     Decimal                  @default(0) @db.Decimal(14, 2)
  balance           Decimal                  @db.Decimal(14, 2)
  date              DateTime
  treasuryAccountId String
  paymentMethod     LightweightPaymentMethod
  reference         String?
  notes             String?
  status            TreasuryAdvanceStatus    @default(AVAILABLE)
  createdByUserId   String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  treasuryAccount   TreasuryAccount          @relation(fields: [treasuryAccountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer          LightweightCustomer?     @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  supplier          LightweightSupplier?     @relation(fields: [supplierId, tenantId], references: [id, tenantId], onDelete: Restrict)
  applications      AdvanceApplication[]

  @@unique([id, tenantId])
  @@index([tenantId, type, status])
}

model AdvanceApplication {
  id              String             @id @default(cuid())
  tenantId        String
  advanceId       String
  obligationId    String
  amount          Decimal            @db.Decimal(14, 2)
  requestKey      String
  createdByUserId String
  createdAt       DateTime           @default(now())
  advance         TreasuryAdvance    @relation(fields: [advanceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  obligation      TreasuryObligation @relation(fields: [obligationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, requestKey])
  @@index([tenantId, obligationId])
}

model CardTransaction {
  id                     String                @id @default(cuid())
  tenantId               String
  cardAccountId          String
  saleId                 String?
  obligationId           String?
  sourceId               String
  grossAmount            Decimal               @db.Decimal(14, 2)
  feeAmount              Decimal               @db.Decimal(14, 2)
  netAmount              Decimal               @db.Decimal(14, 2)
  transactionDate        DateTime
  expectedSettlementDate DateTime?
  settledAt              DateTime?
  reference              String?
  status                 CardTransactionStatus @default(PENDING)
  bankMovementId         String?               @unique
  createdByUserId        String
  cardAccount            TreasuryAccount       @relation(fields: [cardAccountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sale                   LightweightSale?      @relation(fields: [saleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  obligation             TreasuryObligation?   @relation(fields: [obligationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, sourceId])
  @@index([tenantId, status, expectedSettlementDate])
}

// ========================================
// Accounting Core
// ========================================

model AccountingPlan {
  id              String               @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  status          AccountingPlanStatus  @default(DRAFT)
  source          String?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts AccountingAccount[]

  @@index([tenantId])
}

model AccountingAccount {
  id            String                  @id @default(cuid())
  tenantId      String
  planId        String
  code          String
  name          String
  description   String?
  parentId      String?
  level         Int                     @default(1)
  rootType      AccountingRootType
  normalBalance AccountingNormalBalance
  isGroup       Boolean                 @default(false)
  allowsPosting Boolean                 @default(true)
  active        Boolean                 @default(true)
  systemLocked  Boolean                 @default(false)
  f101Code      String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan    AccountingPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  parent  AccountingAccount? @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children AccountingAccount[] @relation("AccountHierarchy")

  journalLines        AccountingJournalLine[]
  mappings            AccountingAccountMapping[]
  costExpenseAsCost   AccountingCostExpenseConcept[] @relation("CostAccount")
  costExpenseAsExpense AccountingCostExpenseConcept[] @relation("ExpenseAccount")
  withholdingAsAsset   TaxWithholdingAccountMapping[] @relation("WithholdingAsset")
  withholdingAsLiability TaxWithholdingAccountMapping[] @relation("WithholdingLiability")
  withholdingAsExpense TaxWithholdingAccountMapping[] @relation("WithholdingExpense")
  productSalesAccounts     LightweightProduct[] @relation("ProductSalesAccount")
  productInventoryAccounts LightweightProduct[] @relation("ProductInventoryAccount")
  productCogsAccounts      LightweightProduct[] @relation("ProductCogsAccount")
  productPurchaseAccounts  LightweightProduct[] @relation("ProductPurchaseAccount")

  @@unique([tenantId, planId, code])
  @@index([tenantId])
  @@index([planId])
  @@index([tenantId, planId, parentId])
}

model AccountingAccountMapping {
  id        String                       @id @default(cuid())
  tenantId  String
  key       AccountingAccountMappingKey
  accountId String
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TaxWithholdingAccountMapping {
  id                String  @id @default(cuid())
  tenantId          String
  withholdingCodeId String
  assetAccountId    String?
  liabilityAccountId String?
  expenseAccountId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  withholdingCode TaxWithholdingCode @relation(fields: [withholdingCodeId], references: [id], onDelete: Cascade)
  assetAccount    AccountingAccount? @relation("WithholdingAsset", fields: [assetAccountId], references: [id], onDelete: SetNull)
  liabilityAccount AccountingAccount? @relation("WithholdingLiability", fields: [liabilityAccountId], references: [id], onDelete: SetNull)
  expenseAccount  AccountingAccount? @relation("WithholdingExpense", fields: [expenseAccountId], references: [id], onDelete: SetNull)

  @@unique([tenantId, withholdingCodeId])
  @@index([tenantId])
}

model AccountingCostExpenseConcept {
  id               String  @id @default(cuid())
  tenantId         String
  code             String
  name             String
  description      String?
  costAccountId    String?
  expenseAccountId String?
  active           Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  costAccount    AccountingAccount? @relation("CostAccount", fields: [costAccountId], references: [id], onDelete: SetNull)
  expenseAccount AccountingAccount? @relation("ExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model AccountingCostCenter {
  id          String                    @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  type        AccountingCostCenterType  @default(COST_CENTER)
  parentId    String?
  active      Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   AccountingCostCenter? @relation("CostCenterHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children AccountingCostCenter[] @relation("CostCenterHierarchy")
  journalLines AccountingJournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model AccountingPeriod {
  id              String                  @id @default(cuid())
  tenantId        String
  year            Int
  month           Int?
  startDate       DateTime
  endDate         DateTime
  status          AccountingPeriodStatus  @default(OPEN)
  closedAt        DateTime?
  closedByUserId  String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, month])
  @@index([tenantId])
  @@index([tenantId, status])
}

model AccountingJournalEntry {
  id               String                         @id @default(cuid())
  tenantId         String
  number           String
  date             DateTime
  description      String
  sourceType       AccountingSourceType            @default(MANUAL)
  sourceId         String?
  status           AccountingJournalEntryStatus    @default(DRAFT)
  totalDebit       Decimal                         @default(0) @db.Decimal(14, 2)
  totalCredit      Decimal                         @default(0) @db.Decimal(14, 2)
  reversalOfId     String?                         @unique
  createdByUserId  String
  postedByUserId   String?
  reversedByUserId String?
  postedAt         DateTime?
  reversedAt       DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reversalOf AccountingJournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy AccountingJournalEntry? @relation("JournalReversal")
  lines      AccountingJournalLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, status])
}

model AccountingJournalLine {
  id               String  @id @default(cuid())
  tenantId         String
  entryId          String
  accountId        String
  description      String?
  debit            Decimal @default(0) @db.Decimal(14, 2)
  credit           Decimal @default(0) @db.Decimal(14, 2)
  costCenterId     String?
  counterpartyType String?
  counterpartyId   String?
  reference        String?
  createdAt        DateTime @default(now())

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry      AccountingJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account    AccountingAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCenter AccountingCostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([entryId])
  @@index([accountId])
  @@index([tenantId, accountId])
}

model AccountingSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  autoPostingEnabled Boolean  @default(false)
  configuredAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Inventory Core enums ──────────────────────────────────────────────

enum InventoryMovementDirection {
  IN
  OUT
}

enum InventoryMovementType {
  OPENING
  SALE
  SALE_RETURN
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  PHYSICAL_COUNT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  COMBO_CONSUMPTION
  OTHER
}

enum InventoryPhysicalCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InventoryTransferStatus {
  DRAFT
  PENDING
  COMPLETED
  CANCELLED
}

enum ShipmentGuideStatus {
  DRAFT
  ISSUED
  REFERRAL_GUIDE_SRI_PENDING
  CANCELLED
}

enum InventoryOrderStatus {
  DRAFT
  PENDING
  APPROVED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum InventoryValuationMethod {
  WEIGHTED_AVERAGE
  FIFO
}

enum ProductTaxCategory {
  TAXABLE
  ZERO
  NON_OBJECT
  EXEMPT
}

enum WarrantyUnit {
  DAYS
  MONTHS
  YEARS
}

// ─── Inventory Core models ─────────────────────────────────────────────

model InventoryBrand {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products LightweightProduct[] @relation("ProductBrand")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model InventoryUnit {
  id           String   @id @default(cuid())
  tenantId     String
  code         String
  name         String
  abbreviation String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products LightweightProduct[] @relation("ProductUnit")

  @@unique([tenantId, code])
  @@index([tenantId])
}

model InventoryWarehouse {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  address   String?
  city      String?
  phone     String?
  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockBalances         InventoryStockBalance[]
  movements             InventoryMovement[]
  physicalCounts        InventoryPhysicalCount[]
  transfersOut          InventoryTransfer[]         @relation("TransferSource")
  transfersIn           InventoryTransfer[]         @relation("TransferDestination")
  defaultForProducts    LightweightProduct[]        @relation("ProductDefaultWarehouse")
  shipmentGuides        ShipmentGuide[]             @relation("GuideSourceWarehouse")
  orders                InventoryOrder[]
  defaultForSettings    InventorySettings[]         @relation("SettingsDefaultWarehouse")

  @@unique([tenantId, code])
  @@index([tenantId])
}

model InventoryStockBalance {
  id          String   @id @default(cuid())
  tenantId    String
  warehouseId String
  productId   String
  quantity    Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt   DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   LightweightProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([productId])
}

model InventoryMovement {
  id              String                     @id @default(cuid())
  tenantId        String
  productId       String
  warehouseId     String
  direction       InventoryMovementDirection
  quantity        Decimal                    @db.Decimal(14, 4)
  movementType    InventoryMovementType
  date            DateTime
  reference       String?
  description     String?
  sourceType      String?
  sourceId        String?
  transferGroupId String?
  unitCost        Decimal?                   @db.Decimal(14, 4)
  createdByUserId String
  createdAt       DateTime                   @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   LightweightProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@index([tenantId, productId, warehouseId, date])
  @@index([tenantId, sourceType, sourceId])
  @@index([transferGroupId])
}

model InventoryPhysicalCount {
  id                String                        @id @default(cuid())
  tenantId          String
  warehouseId       String
  number            String
  status            InventoryPhysicalCountStatus   @default(DRAFT)
  startedAt         DateTime                       @default(now())
  completedAt       DateTime?
  createdByUserId   String
  completedByUserId String?
  notes             String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  tenant    Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse InventoryWarehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items     InventoryPhysicalCountItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

model InventoryPhysicalCountItem {
  id               String   @id @default(cuid())
  physicalCountId  String
  productId        String
  expectedQuantity Decimal  @db.Decimal(14, 4)
  countedQuantity  Decimal? @db.Decimal(14, 4)
  difference       Decimal? @db.Decimal(14, 4)
  unitCost         Decimal? @db.Decimal(14, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  physicalCount InventoryPhysicalCount @relation(fields: [physicalCountId], references: [id], onDelete: Cascade)
  product       LightweightProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([physicalCountId, productId])
  @@index([physicalCountId])
}

model InventoryTransfer {
  id                     String                   @id @default(cuid())
  tenantId               String
  number                 String
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 InventoryTransferStatus  @default(DRAFT)
  createdByUserId        String
  completedByUserId      String?
  createdAt              DateTime                 @default(now())
  completedAt            DateTime?
  notes                  String?
  updatedAt              DateTime                 @updatedAt

  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceWarehouse      InventoryWarehouse      @relation("TransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Cascade)
  destinationWarehouse InventoryWarehouse      @relation("TransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Cascade)
  items                InventoryTransferItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

model InventoryTransferItem {
  id         String  @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal @db.Decimal(14, 4)

  transfer InventoryTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  LightweightProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([transferId, productId])
  @@index([transferId])
}

model InventoryVehicle {
  id        String   @id @default(cuid())
  tenantId  String
  plate     String
  brand     String?
  model     String?
  year      Int?
  color     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipmentGuides ShipmentGuide[]

  @@unique([tenantId, plate])
  @@index([tenantId])
}

model ShipmentGuide {
  id                     String              @id @default(cuid())
  tenantId               String
  number                 String
  status                 ShipmentGuideStatus @default(DRAFT)
  issueDate              DateTime
  startTransportDate     DateTime
  endTransportDate       DateTime?
  originAddress          String
  destinationAddress     String
  route                  String?
  reason                 String
  carrierIdentification  String?
  carrierName            String?
  vehicleId              String?
  sourceWarehouseId      String?
  saleId                 String?
  transferId             String?
  notes                  String?
  createdByUserId        String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle         InventoryVehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  sourceWarehouse InventoryWarehouse? @relation("GuideSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  items           ShipmentGuideItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, issueDate])
}

model ShipmentGuideItem {
  id          String  @id @default(cuid())
  guideId     String
  productId   String?
  code        String
  description String
  quantity    Decimal @db.Decimal(14, 4)

  guide   ShipmentGuide       @relation(fields: [guideId], references: [id], onDelete: Cascade)
  product LightweightProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([guideId])
}

model InventoryOrder {
  id              String               @id @default(cuid())
  tenantId        String
  number          String
  warehouseId     String
  supplierId      String?
  status          InventoryOrderStatus @default(DRAFT)
  requestedAt     DateTime             @default(now())
  expectedAt      DateTime?
  notes           String?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse InventoryWarehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  supplier  LightweightSupplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items     InventoryOrderItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

model InventoryOrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  requestedQuantity Decimal  @db.Decimal(14, 4)
  receivedQuantity  Decimal  @default(0) @db.Decimal(14, 4)
  unitCostEstimate  Decimal? @db.Decimal(14, 4)

  order   InventoryOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product LightweightProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([orderId])
}

model ProductPriceChange {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  channel   String
  oldPrice  Decimal  @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  reason    String?
  userId    String
  createdAt DateTime @default(now())

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product LightweightProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, createdAt])
}

model InventorySettings {
  id                  String                    @id @default(cuid())
  tenantId            String                    @unique
  defaultWarehouseId  String?
  allowNegativeStock  Boolean                   @default(false)
  valuationMethod     InventoryValuationMethod  @default(WEIGHTED_AVERAGE)
  catalogShowBrand    Boolean                   @default(true)
  catalogShowUnit     Boolean                   @default(false)
  catalogShowStock    Boolean                   @default(false)
  catalogShowPrice    Boolean                   @default(true)
  catalogShowCode     Boolean                   @default(true)
  catalogOrientation  String                    @default("vertical")
  catalogAccentColor  String?
  catalogHeaderAll    Boolean                   @default(true)
  barcodeFormat       String                    @default("A4")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultWarehouse InventoryWarehouse? @relation("SettingsDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
}

enum SriCancellationStatus {
  QUEUED
  RUNNING
  SUBMITTED
  CONFIRMED
  FAILED
  HUMAN_VERIFICATION_REQUIRED
  NOT_ELIGIBLE
  CANCELLED_BY_USER
}

enum SriCancellationReason {
  EMISSION_ERROR
  OPERATION_NOT_OCCURRED
}

model SriCancellationRequest {
  id                  String                  @id @default(cuid())
  tenantId            String
  sriDocumentId       String
  status              SriCancellationStatus   @default(QUEUED)
  reasonCode          SriCancellationReason
  reasonText          String?
  requestedByUserId   String
  requestedAt         DateTime                @default(now())
  claimedAt           DateTime?
  submittedAt         DateTime?
  confirmedAt         DateTime?
  failedAt            DateTime?
  workerId            String?
  attemptCount        Int                     @default(0)
  sriRequestNumber    String?
  lastErrorCode       String?
  lastErrorMessage    String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sriDocument SriDocument @relation(fields: [sriDocumentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sriDocumentId])
  @@index([status])
  @@index([tenantId, sriDocumentId])
}

model UserHomePreference {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  shortcutKeys Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}
